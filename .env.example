# ========================================================
# SecureChainFlow Environment Variables Template
# Copy to .env and fill in values for your environment.
# NEVER commit real credentials, private keys, or tokens.
# ========================================================

# --- Backend Configuration ---
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (MongoDB Atlas or Local/In-Memory) ---
MONGODB_URI=mongodb://localhost:27017/securechainflow
USE_IN_MEMORY_DB=true

# --- Authentication & Security ---
JWT_SECRET=change_this_to_a_secure_random_64_byte_string_in_production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- AI/ML Service ---
AI_SERVICE_URL=http://localhost:8000

# --- Object Storage (AWS S3 / GCP / MinIO / Local) ---
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=securechainflow-documents
OBJECT_STORAGE_REGION=us-east-1

# --- Hyperledger Fabric Configuration ---
# Set to 'false' if running against a live Fabric network with valid credentials
FABRIC_USE_MOCK_GATEWAY=true
FABRIC_CONNECTION_PROFILE=blockchain/network/connection-org1.json
FABRIC_WALLET_PATH=blockchain/network/wallet
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=securechainflow
FABRIC_MSP_ID=Org1MSP

# --- Frontend (Public Configuration) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=SecureChainFlow
