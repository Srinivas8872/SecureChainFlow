# ==============================================================================
# SecureChainFlow Backend Environment Configuration (.env.example)
# ==============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# For MongoDB Atlas in production: mongodb+srv://<username>:<password>@cluster.mongodb.net/securechainflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/securechainflow
USE_IN_MEMORY_DB=true

# --- Authentication ---
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_character_string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- AI Service Integration ---
AI_SERVICE_URL=http://localhost:8000

# --- Hyperledger Fabric Gateway ---
# In development / sandbox mode, keep FABRIC_USE_MOCK_GATEWAY=true
# In production, set to false and provide valid connection-org1.json and wallet certificates
FABRIC_USE_MOCK_GATEWAY=true
FABRIC_CONNECTION_PROFILE=blockchain/network/connection-org1.json
FABRIC_WALLET_PATH=blockchain/network/wallet
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=securechainflow
FABRIC_MSP_ID=Org1MSP

# --- Optional Object Storage ---
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=securechainflow-documents
OBJECT_STORAGE_REGION=us-east-1
