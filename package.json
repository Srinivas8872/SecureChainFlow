{
  "name": "securechainflow",
  "version": "1.0.0",
  "private": true,
  "description": "SecureChainFlow: Blockchain and AI Integrated Platform for Secure and Transparent Supply Chain Management",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test:chaincode": "npm --prefix backend test -- --rootDir .. blockchain/chaincode/test --testMatch **/*.test.js",
    "test:ai": "cd ai-service && .venv\\Scripts\\python -m pytest tests",
    "train:ai": "cd ai-service && .venv\\Scripts\\python training/train_baseline.py",
    "seed:backend": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
